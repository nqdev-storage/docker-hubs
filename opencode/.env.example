# Copy sang .env rồi điền giá trị thật (.env không được commit vào git)
# Tham khảo:
# - OpenCode v1 docs: https://opencode.ai/docs/cli/
# - OpenCode v2 docs: https://opencode.ai/v2/docs (docker-compose.yml đang dùng image v2 - 2.0.18)
#   Lưu ý: v2 chưa có trang liệt kê đầy đủ ENV như v1; các biến OPENCODE_* bên dưới
#   là từ docs v1, một số có thể không còn áp dụng cho v2 - kiểm tra `opencode --help` nếu nghi ngờ.

# ---------------------------------------------------------------------------
# Dùng trực tiếp bởi opencode/docker-compose.yml
# ---------------------------------------------------------------------------

# Timezone của container
TZ=Asia/Ho_Chi_Minh

# Basic auth cho web UI / `opencode serve`
# username mặc định là opencode
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me

# WakaTime API key (một số plugin/CLI WakaTime đọc trực tiếp từ ENV này)
WAKATIME_API_KEY=ak-api-key

# ---------------------------------------------------------------------------
# Core / config (v1 + v2)
# ---------------------------------------------------------------------------

# Tự động chia sẻ session
# OPENCODE_AUTO_SHARE=false

# Đường dẫn Git Bash trên Windows
# OPENCODE_GIT_BASH_PATH=

# Đường dẫn tới file config / thư mục config
# OPENCODE_CONFIG=
# OPENCODE_TUI_CONFIG=
# OPENCODE_CONFIG_DIR=

# Nội dung config dạng JSON inline (ghi đè file config)
# OPENCODE_CONFIG_CONTENT=

# Định danh client (mặc định: cli)
# OPENCODE_CLIENT=cli

# URL tuỳ chỉnh để lấy danh sách models
# OPENCODE_MODELS_URL=

# [v2] Đường dẫn override cho database
# OPENCODE_DB=

# [v2] Áp dụng cấu hình CLI dạng JSON inline, merge lên cli.json
# OPENCODE_CLI_CONFIG_CONTENT=

# [v2] Thư mục config thay thế theo chuẩn XDG (dùng $XDG_CONFIG_HOME/opencode/cli.json)
# XDG_CONFIG_HOME=

# ---------------------------------------------------------------------------
# Tắt tính năng (Disable)
# ---------------------------------------------------------------------------

# Tắt kiểm tra tự động cập nhật
# OPENCODE_DISABLE_AUTOUPDATE=false

# Tắt tự động dọn dữ liệu cũ
# OPENCODE_DISABLE_PRUNE=false

# Tắt tự động đổi tiêu đề terminal
# OPENCODE_DISABLE_TERMINAL_TITLE=false

# Tắt các plugin mặc định
# OPENCODE_DISABLE_DEFAULT_PLUGINS=false

# Tắt tự động tải LSP server
# OPENCODE_DISABLE_LSP_DOWNLOAD=false

# Tắt tự động nén context (autocompact)
# OPENCODE_DISABLE_AUTOCOMPACT=false

# Tắt đọc thư mục .claude (prompt + skills)
# OPENCODE_DISABLE_CLAUDE_CODE=false

# Tắt đọc ~/.claude/CLAUDE.md
# OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=false

# Tắt load .claude/skills
# OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=false

# Tắt fetch danh sách models từ remote
# OPENCODE_DISABLE_MODELS_FETCH=false

# Tắt bắt sự kiện chuột trong TUI
# OPENCODE_DISABLE_MOUSE=false

# ---------------------------------------------------------------------------
# Bật tính năng (Enable) / Permission
# ---------------------------------------------------------------------------

# Bật các model thử nghiệm (experimental models)
# OPENCODE_ENABLE_EXPERIMENTAL_MODELS=false

# Bật công cụ web search Exa
# OPENCODE_ENABLE_EXA=false

# Bật công cụ web search Parallel
# OPENCODE_ENABLE_PARALLEL=false

# Cấu hình permission dạng JSON inline
# OPENCODE_PERMISSION=

# Giả lập VCS provider (dùng cho testing)
# OPENCODE_FAKE_VCS=false

# ---------------------------------------------------------------------------
# Experimental (chỉ bật khi cần, có thể đổi/gỡ bất kỳ lúc nào)
# ---------------------------------------------------------------------------

# Bật cờ tổng cho toàn bộ tính năng thử nghiệm
# OPENCODE_EXPERIMENTAL=false

# Bật tính năng khám phá icon
# OPENCODE_EXPERIMENTAL_ICON_DISCOVERY=false

# Tắt copy-on-select trong TUI
# OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=false

# Timeout mặc định (ms) cho lệnh bash
# OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=

# Số token output tối đa cho phản hồi LLM
# OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=

# Bật/tắt file watcher cho toàn bộ thư mục
# OPENCODE_EXPERIMENTAL_FILEWATCHER=false
# OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=false

# Bật formatter oxfmt
# OPENCODE_EXPERIMENTAL_OXFMT=false

# Bật LSP tool thử nghiệm / LSP TY cho Python
# OPENCODE_EXPERIMENTAL_LSP_TOOL=false
# OPENCODE_EXPERIMENTAL_LSP_TY=false

# Bật tính năng Exa / Parallel bản thử nghiệm
# OPENCODE_EXPERIMENTAL_EXA=false
# OPENCODE_EXPERIMENTAL_PARALLEL=false

# Bật plan mode
# OPENCODE_EXPERIMENTAL_PLAN_MODE=false

# Bật background subagent tasks
# OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false

# Bật event system thử nghiệm
# OPENCODE_EXPERIMENTAL_EVENT_SYSTEM=false

# Bật đường xử lý LLM request kiểu native
# OPENCODE_EXPERIMENTAL_NATIVE_LLM=false

# Bật Scout subagent
# OPENCODE_EXPERIMENTAL_SCOUT=false

# Bật hỗ trợ workspace
# OPENCODE_EXPERIMENTAL_WORKSPACES=false
