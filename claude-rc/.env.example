# Copy sang .env rồi điền giá trị thật (.env không được commit vào git)

# ---------------------------------------------------------------------------
# Dùng trực tiếp bởi claude-rc/docker-compose.yml
# ---------------------------------------------------------------------------

# Timezone của container
TZ=Asia/Ho_Chi_Minh

# Prefix tên session Remote Control tự sinh (tùy chọn)
# CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX=docker

# ---------------------------------------------------------------------------
# KHÔNG đặt các biến sau trong file này (Remote Control sẽ không hoạt động)
#   - ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN
#   - ANTHROPIC_BASE_URL (khác api.anthropic.com)
#   - DISABLE_GROWTHBOOK, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
# Đăng nhập bằng `claude auth login` (tài khoản claude.ai), không dùng API key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GIT Config
# ---------------------------------------------------------------------------
GITHUB_USERNAME=<gh-usersname>

# Personal Access Tokens (https://github.com/settings/tokens)
GITHUB_TOKEN=<gh-personal-access-token>

# Git author/committer (để commit không bị lỗi danh tính)
GIT_AUTHOR_NAME=<gh-usersname>
GIT_AUTHOR_EMAIL=<gh-usersname>@users.noreply.github.com
GIT_COMMITTER_NAME=<gh-usersname>
GIT_COMMITTER_EMAIL=<gh-usersname>@users.noreply.github.com

# Tránh git hỏi mật khẩu tương tác trong container
GIT_TERMINAL_PROMPT=0

# (Tùy chọn) Nếu dùng GitHub CLI hoặc API trong container
GITHUB_API_URL=https://api.github.com
